#!/usr/bin/python3
"""
Deployed by oshvl.infra.ops_agent_sudo — DO NOT EDIT ON THE NODE, changes
will be overwritten on the next deploy.

All real paths below are baked in at Ansible-apply time. This script accepts
no path or shell arguments from its caller, only a fixed --action enum plus
--apply — deliberately, to keep the sudoers grant that invokes this script
to exactly one absolute path with no caller-controlled arguments.
"""

import argparse
import shutil
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

RUNNER_HOME = "{{ ops_agent_sudo_runner_home }}"
JOURNAL_VACUUM_SIZE = "{{ ops_agent_sudo_journal_vacuum_size | default('500M') }}"
CLAUDE_VERSION_HOMES = {{ (ops_agent_sudo_claude_version_homes | default([ops_agent_sudo_runner_home])) | to_json }}
CLAUDE_KEEP_NEWEST_N = {{ ops_agent_sudo_claude_keep_newest_n | default(3) }}

BUN_CACHE_DIR = f"{RUNNER_HOME}/.bun/install/cache"
RUNNER_PIP_CACHE_DIR = f"{RUNNER_HOME}/.cache/pip"
ROOT_PIP_CACHE_DIR = "/root/.cache/pip"
RUNNER_WORK_DIR = f"{RUNNER_HOME}/actions-runner/_work"
RUNNER_DIAG_DIR = f"{RUNNER_HOME}/actions-runner/_diag"

MAX_AGE_DAYS_CACHES = 14
MAX_AGE_DAYS_WORK = 30
MAX_AGE_DAYS_DIAG = 7
ORPHANED_HOME_MIN_AGE_DAYS = 90

ACTIONS = [
    "bun-cache",
    "runner-pip-cache",
    "root-pip-cache",
    "runner-work-cache",
    "runner-diag-logs",
    "claude-old-versions",
    "journal-vacuum",
    "list-orphaned-homes",
]


def _runner_is_busy() -> bool:
    """Defense in depth: independently re-check runner idleness, regardless
    of whatever the unprivileged caller already decided."""
    result = subprocess.run(["ps", "-eo", "cmd"], capture_output=True, text=True, timeout=10)
    return "Runner.Worker" in result.stdout


def _delete_path(path: Path) -> None:
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink()


def _prune_by_age(base_dir: str, max_age_days: int, apply: bool) -> None:
    base = Path(base_dir)
    if not base.exists():
        print(f"{base_dir}: does not exist, nothing to do")
        return
    cutoff = datetime.now().timestamp() - max_age_days * 86400
    for child in sorted(base.iterdir()):
        try:
            if child.lstat().st_mtime >= cutoff:
                continue
        except OSError:
            continue
        if apply:
            print(f"deleting {child}")
            _delete_path(child)
        else:
            print(f"[dry-run] would delete {child}")


def _prune_keep_newest_n(base_dir: str, keep_newest_n: int, apply: bool) -> None:
    base = Path(base_dir)
    if not base.exists():
        print(f"{base_dir}: does not exist, nothing to do")
        return
    dated = []
    for child in base.iterdir():
        try:
            dated.append((child.lstat().st_mtime, child))
        except OSError:
            continue
    dated.sort(key=lambda pair: pair[0], reverse=True)
    for _, child in dated[keep_newest_n:]:
        if apply:
            print(f"deleting {child}")
            _delete_path(child)
        else:
            print(f"[dry-run] would delete {child}")


def _journal_vacuum(apply: bool) -> None:
    if not apply:
        print(f"[dry-run] would run: journalctl --vacuum-size={JOURNAL_VACUUM_SIZE}")
        return
    subprocess.run(["journalctl", f"--vacuum-size={JOURNAL_VACUUM_SIZE}"], check=False)


def _list_orphaned_homes() -> None:
    """Report-only, forever — never deletes anything, regardless of --apply.
    Dead runner homes need a human to confirm before removal (mirrors the
    finance-github-runner incident this tool was designed after)."""
    result = subprocess.run(
        ["systemctl", "list-units", "--all", "--no-legend", "--plain", "--type=service"],
        capture_output=True, text=True, timeout=10,
    )
    active_users = set()
    for line in result.stdout.splitlines():
        parts = line.split()
        if parts:
            active_users.add(parts[0])

    home = Path("/home")
    if not home.exists():
        return
    cutoff = datetime.now().timestamp() - ORPHANED_HOME_MIN_AGE_DAYS * 86400
    for entry in sorted(home.iterdir()):
        if not entry.is_dir():
            continue
        try:
            mtime = entry.lstat().st_mtime
        except OSError:
            continue
        if mtime >= cutoff:
            continue
        print(f"candidate orphaned home (report-only, never auto-deleted): {entry}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--action", required=True, choices=ACTIONS)
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()

    if args.action == "runner-work-cache" and _runner_is_busy():
        print("refused: runner has an in-flight job", file=sys.stderr)
        return 3

    if args.action == "bun-cache":
        _prune_by_age(BUN_CACHE_DIR, MAX_AGE_DAYS_CACHES, args.apply)
    elif args.action == "runner-pip-cache":
        _prune_by_age(RUNNER_PIP_CACHE_DIR, MAX_AGE_DAYS_CACHES, args.apply)
    elif args.action == "root-pip-cache":
        _prune_by_age(ROOT_PIP_CACHE_DIR, MAX_AGE_DAYS_CACHES, args.apply)
    elif args.action == "runner-work-cache":
        _prune_by_age(RUNNER_WORK_DIR, MAX_AGE_DAYS_WORK, args.apply)
    elif args.action == "runner-diag-logs":
        _prune_by_age(RUNNER_DIAG_DIR, MAX_AGE_DAYS_DIAG, args.apply)
    elif args.action == "claude-old-versions":
        for home in CLAUDE_VERSION_HOMES:
            _prune_keep_newest_n(f"{home}/.local/share/claude/versions", CLAUDE_KEEP_NEWEST_N, args.apply)
    elif args.action == "journal-vacuum":
        _journal_vacuum(args.apply)
    elif args.action == "list-orphaned-homes":
        _list_orphaned_homes()

    return 0


if __name__ == "__main__":
    sys.exit(main())
